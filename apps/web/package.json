{
  "name": "@ecokart/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3210",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc",
    "test": "vitest run",
    "test:harness": "vitest run --config vitest.harness.config.ts",
    "test:e2e": "node scripts/test-e2e.ts",
    "test:e2e:smoke": "node scripts/test-e2e.ts --project=chromium-desktop --project=chromium-phone --grep=@smoke",
    "test:e2e:verify-harness": "vitest run --config vitest.harness.config.ts && node scripts/verify-e2e.ts",
    "test:e2e:report": "node scripts/test-e2e-report.ts",
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.ts"
  },
  "dependencies": {
    "@ecokart/core": "workspace:*",
    "better-auth": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "drizzle-orm": "catalog:",
    "sharp": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
