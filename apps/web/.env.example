# Copy to .env for local development. Matches the services in compose.yaml.
# The web app logs in as ecokart_web, which row-level security applies to.
# Its password is set by `pnpm db:migrate` from packages/core/.env.
DATABASE_URL=postgres://ecokart_web:ecokart_web@localhost:15434/ecokart

# Sign-in (backend spec step 2). The example secrets contain
# "development-only" and are refused when NODE_ENV=production.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=development-only-secret-replace-in-production
# 32 random bytes in base64; must match apps/worker/.env.
# Generate a real one with: openssl rand -base64 32
MESSAGE_ENCRYPTION_KEY=ZGV2ZWxvcG1lbnQtb25seS1lbmNyeXB0aW9uLWtleSE=
# none keeps phone sign-in off; mailpit delivers SMS codes to Mailpit.
SMS_PROVIDER=mailpit

# Object storage (backend spec step 6): the SeaweedFS service in compose.yaml
# locally, the private S3 bucket in production, where the endpoint and keys
# are left out so the task role is used. The example secret contains
# "development-only" and is refused when NODE_ENV=production.
STORAGE_BUCKET=ecokart
STORAGE_REGION=ap-south-1
STORAGE_ENDPOINT=http://localhost:8333
STORAGE_ACCESS_KEY_ID=ecokart
STORAGE_SECRET_ACCESS_KEY=development-only-storage-secret
# Where public product photos are served from: CloudFront in production.
STORAGE_PUBLIC_URL=http://localhost:8333/ecokart

# How many proxies append to X-Forwarded-For in front of the web app
# (backend spec step 9): 1 for the load balancer alone (the default), 2 with
# CloudFront in front of it. Per-address limits and audit entries read the
# visitor's address that many entries from the right.
# TRUSTED_PROXY_COUNT=1

# AI (backend spec step 17, design doc 3.2). false switches every AI feature
# off: AI calls answer 503 and the AI_* lines below are not read. To switch
# AI on, set true and put this environment's OpenRouter key in AI_API_KEY.
AI_ENABLED=false
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_CHAT_MODEL=deepseek/deepseek-v4.1-flash
AI_VISION_MODEL=deepseek/deepseek-v4.1-flash
AI_EMBED_MODEL=voyageai/voyage-multimodal-3.5
# Must match the size of product_embeddings.embedding.
AI_EMBED_DIMENSIONS=1024
# Optional, set together: embeddings from another provider than chat.
AI_EMBED_BASE_URL=
AI_EMBED_API_KEY=

# Razorpay (backend spec step 12, design doc 6.3). Blank switches online
# payment off and leaves cash on delivery. To switch it on, set all three
# from this environment's Razorpay dashboard; the webhook secret is the one
# typed in when adding the webhook (Settings, Webhooks).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional: a stand-in server for local runs. Must be blank in production.
RAZORPAY_API_URL=
