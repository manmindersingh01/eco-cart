# Copy to .env for local development. Matches the services in compose.yaml.
# The web app logs in as ecokart_web, which row-level security applies to.
# Its password is set by `pnpm db:migrate` from packages/core/.env.
DATABASE_URL=postgres://ecokart_web:ecokart_web@localhost:15434/ecokart

# Sign-in (backend spec step 2). The example secrets contain
# "development-only" and are refused when NODE_ENV=production.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=development-only-secret-replace-in-production
# 32 random bytes in base64; must match apps/worker/.env.
# Generate a real one with: openssl rand -base64 32
MESSAGE_ENCRYPTION_KEY=ZGV2ZWxvcG1lbnQtb25seS1lbmNyeXB0aW9uLWtleSE=
# none keeps phone sign-in off; mailpit delivers SMS codes to Mailpit.
SMS_PROVIDER=mailpit

# Object storage (backend spec step 6): the SeaweedFS service in compose.yaml
# locally, the private S3 bucket in production, where the endpoint and keys
# are left out so the task role is used. The example secret contains
# "development-only" and is refused when NODE_ENV=production.
STORAGE_BUCKET=ecokart
STORAGE_REGION=ap-south-1
STORAGE_ENDPOINT=http://localhost:8333
STORAGE_ACCESS_KEY_ID=ecokart
STORAGE_SECRET_ACCESS_KEY=development-only-storage-secret
# Where public product photos are served from: CloudFront in production.
STORAGE_PUBLIC_URL=http://localhost:8333/ecokart
