# Copy to .env for local development. Matches the services in compose.yaml.
# The worker logs in as ecokart_worker. Its password is set by
# `pnpm db:migrate` from packages/core/.env.
DATABASE_URL=postgres://ecokart_worker:ecokart_worker@localhost:5434/ecokart

# Sending email and SMS (backend spec step 2). Locally both go to Mailpit:
# open http://localhost:8025 to read them.
EMAIL_PROVIDER=mailpit
EMAIL_FROM=EcoKart <no-reply@ecokart.test>
MAILPIT_URL=http://localhost:8025
SMS_PROVIDER=mailpit
# Must match apps/web/.env. The example contains "development-only" and is
# refused when NODE_ENV=production.
MESSAGE_ENCRYPTION_KEY=ZGV2ZWxvcG1lbnQtb25seS1lbmNyeXB0aW9uLWtleSE=
