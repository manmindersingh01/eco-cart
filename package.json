{
  "name": "ecokart",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.12.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "test:e2e": "pnpm --filter @ecokart/web test:e2e",
    "test:e2e:demo": "pnpm --filter @ecokart/web test:e2e:demo",
    "test:e2e:smoke": "pnpm --filter @ecokart/web test:e2e:smoke",
    "test:e2e:verify-harness": "pnpm --filter @ecokart/web test:e2e:verify-harness",
    "test:e2e:report": "pnpm --filter @ecokart/web test:e2e:report",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up --detach --wait && pnpm --filter @ecokart/core storage:setup",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @ecokart/core db:migrate",
    "db:seed": "pnpm --filter @ecokart/core db:seed",
    "db:generate": "pnpm --filter @ecokart/core db:generate",
    "auth:schema": "pnpm --filter @ecokart/core auth:schema",
    "admin:create": "pnpm --filter @ecokart/web admin:create",
    "demo:flow": "pnpm --filter @ecokart/web demo:flow",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
