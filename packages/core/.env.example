# Copy to .env for local development.
# Used by `pnpm db:migrate`: the migration user owns the tables, and the two
# passwords are set on the ecokart_web and ecokart_worker users that the web
# app and worker log in as, so they must match DATABASE_URL in apps/web/.env
# and apps/worker/.env.
MIGRATION_DATABASE_URL=postgres://ecokart:ecokart@localhost:15434/ecokart
WEB_DATABASE_PASSWORD=ecokart_web
WORKER_DATABASE_PASSWORD=ecokart_worker

# Used by `pnpm db:seed`, which saves example data through the same services
# as the web app, so it logs in as the web app's database user.
DATABASE_URL=postgres://ecokart_web:ecokart_web@localhost:15434/ecokart

# Object storage (backend spec step 6): the SeaweedFS service in compose.yaml
# locally, the private S3 bucket in production, where the endpoint and keys
# are left out so the task role is used. The example secret contains
# "development-only" and is refused when NODE_ENV=production.
STORAGE_BUCKET=ecokart
STORAGE_REGION=ap-south-1
STORAGE_ENDPOINT=http://localhost:8333
STORAGE_ACCESS_KEY_ID=ecokart
STORAGE_SECRET_ACCESS_KEY=development-only-storage-secret
# Where public product photos are served from: CloudFront in production.
STORAGE_PUBLIC_URL=http://localhost:8333/ecokart
# Used only by `pnpm db:up` to set up the local bucket: the web app's
# address, which may upload photos straight to the bucket from the browser.
STORAGE_CORS_ORIGINS=http://localhost:3000
