# Copy to .env for local development.
# Used by `pnpm db:migrate`: the migration user owns the tables, and the two
# passwords are set on the ecokart_web and ecokart_worker users that the web
# app and worker log in as, so they must match DATABASE_URL in apps/web/.env
# and apps/worker/.env.
MIGRATION_DATABASE_URL=postgres://ecokart:ecokart@localhost:5434/ecokart
WEB_DATABASE_PASSWORD=ecokart_web
WORKER_DATABASE_PASSWORD=ecokart_worker

# Used by `pnpm db:seed`, which saves example data through the same services
# as the web app, so it logs in as the web app's database user.
DATABASE_URL=postgres://ecokart_web:ecokart_web@localhost:5434/ecokart
