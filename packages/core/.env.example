# Copy to .env for local development. Used only by `pnpm db:migrate`.
# The migration user owns the tables. The two passwords are set on the
# ecokart_web and ecokart_worker users that the web app and worker log in as,
# so they must match DATABASE_URL in apps/web/.env and apps/worker/.env.
MIGRATION_DATABASE_URL=postgres://ecokart:ecokart@localhost:5434/ecokart
WEB_DATABASE_PASSWORD=ecokart_web
WORKER_DATABASE_PASSWORD=ecokart_worker
